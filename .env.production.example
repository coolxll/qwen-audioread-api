QWEN2API_DATA_DIR=/app/data
QWEN2API_API_KEY=replace-with-openssl-rand-hex-32
QWEN2API_RUNTIME=http
QWEN2API_DEFAULT_FORMAT=md
QWEN2API_DELETE_REMOTE=true
QWEN2API_EXPORT_CONCURRENCY=1
QWEN2API_KEEP_JOB_TEXT=false
QWEN2API_KEEP_UPLOADED_INPUT=false
QWEN2API_KEEP_INTERMEDIATE_OUTPUTS=false
QWEN2API_JOB_WORKERS=1
QWEN2API_MAX_RETRIES=2
QWEN2API_RETRY_DELAY_SECONDS=30
QWEN2API_RETRYABLE_ERROR_CODES=TRANSCRIPTION_TIMEOUT,RATE_LIMITED,TRANSCRIPTION_FAILED
QWEN2API_QWEN_ROOT=/app
QWEN2API_QWEN_DOTENV=/app/.env
QWEN2API_QWEN_AUTH_STATE=/app/.auth/qwen-audioread-auth.json
QWEN2API_QWEN_ACCOUNTS_FILE=/app/accounts.json
QWEN_HTTP_COOKIE_MODE=ticket-only
QWEN_OSS_UPLOAD_MODE=multipart
