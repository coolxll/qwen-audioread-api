QWEN2API_HOST=0.0.0.0
QWEN2API_PORT=8000
QWEN2API_DATA_DIR=./data
QWEN2API_API_KEY=
QWEN2API_DEFAULT_FORMAT=md
QWEN2API_DELETE_REMOTE=true
QWEN2API_EXPORT_CONCURRENCY=2
QWEN2API_KEEP_JOB_TEXT=false
QWEN2API_KEEP_UPLOADED_INPUT=false
QWEN2API_KEEP_INTERMEDIATE_OUTPUTS=false
QWEN2API_JOB_WORKERS=2
QWEN2API_MAX_RETRIES=2
QWEN2API_RETRY_DELAY_SECONDS=30
QWEN2API_RETRYABLE_ERROR_CODES=TRANSCRIPTION_TIMEOUT,RATE_LIMITED,TRANSCRIPTION_FAILED

# 默认使用仓库内置的 qwen_web_capture 执行链路。
# 如需切到其他 checkout，可覆盖 QWEN2API_QWEN_ROOT。
QWEN2API_QWEN_ROOT=.

# 默认与服务共用同一个 .env。也可以改成独立文件，例如 ./config/qwen.env
QWEN2API_QWEN_DOTENV=.env

# 单账号默认登录态位置
QWEN2API_QWEN_AUTH_STATE=.auth/qwen-storage-state.json

# 多账号账号池配置；不使用多账号时可留空或不创建该文件
QWEN2API_QWEN_ACCOUNTS_FILE=accounts.json
